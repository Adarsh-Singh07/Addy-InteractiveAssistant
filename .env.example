# ══════════════════════════════════════════════════════════════════
# Addy Voice Agent — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ══════════════════════════════════════════════════════════════════

# ── App ────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=false
APP_SECRET_KEY=change-this-to-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# ── Identity ───────────────────────────────────────────────────────
AGENT_NAME=Addy
USER_NAME=Adarsh
USER_TIMEZONE=Asia/Kolkata

# ── LLM providers ─────────────────────────────────────────────────
# Primary provider: gemini | groq | luna
LLM_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=groq

# Gemini (free tier at aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq (free tier at console.groq.com)
GROQ_API_KEY=
GROQ_MODEL_FAST=llama-3.1-8b-instant
GROQ_MODEL_SMART=llama-3.3-70b-versatile

# ── Voice / Deepgram ───────────────────────────────────────────────
# Get free $200 credits at console.deepgram.com
DEEPGRAM_API_KEY=

# STT: nova-3 recommended for Hindi/Hinglish
STT_MODEL=nova-3
STT_LANGUAGE=multi
STT_ENDPOINTING_MS=300

# TTS: aura-2-asteria-en is low-latency
TTS_MODEL=aura-2-asteria-en

# ── Hermes integration ─────────────────────────────────────────────
# Phase 1: HERMES_MOCK=true (URL provided tomorrow)
HERMES_MOCK=true
HERMES_URL=
HERMES_API_KEY=

# ── GitHub ─────────────────────────────────────────────────────────
# Phase 4 — leave empty for now
GITHUB_TOKEN=

# ── Zoho Mail ──────────────────────────────────────────────────────
# Phase 6 — set up at api-console.zoho.com
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNT_ID=

# ── Google Calendar ────────────────────────────────────────────────
# Phase 7 — see docs/GOOGLE_CALENDAR_OAUTH.md
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=

# ── LinkedIn ───────────────────────────────────────────────────────
# Phase 8 — limited to official LinkedIn API
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=

# ── Qdrant ─────────────────────────────────────────────────────────
# Phase 3 — handled by Docker; change only for external Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# ── Logging ────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=pretty
